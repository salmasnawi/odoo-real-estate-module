<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ========================= -->
    <!-- Window Action -->
    <!-- ========================= -->

    <record id="estate_property_action" model="ir.actions.act_window">

        <field name="name">Properties</field>

        <field name="res_model">estate.property</field>

        <field name="view_mode">list,form</field>

    </record>


    <!-- ========================= -->
    <!-- List View -->
    <!-- ========================= -->

    <record id="estate_property_list_view" model="ir.ui.view">

        <field name="name">estate.property.list</field>

        <field name="model">estate.property</field>

        <field name="arch" type="xml">

            <list>

                <field name="name"/>

                <field name="expected_price"/>

                <field name="selling_price"/>

                <field name="bedrooms"/>

                <field name="living_area"/>

                <field name="owner_id"/>

                <field name="buyer_id"/>

                <field name="state"/>

            </list>

        </field>

    </record>


    <!-- ========================= -->
    <!-- Form View -->
    <!-- ========================= -->

    <record id="estate_property_form_view" model="ir.ui.view">

        <field name="name">estate.property.form</field>

        <field name="model">estate.property</field>

        <field name="arch" type="xml">

            <form>

                <!-- ========================= -->
                <!-- Header -->
                <!-- ========================= -->

                <header>

                    <button
                        name="action_sold"
                        type="object"
                        string="Mark as Sold"
                    />

                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                    />

                </header>


                <sheet>

                    <!-- ========================= -->
                    <!-- Smart Buttons -->
                    <!-- ========================= -->

                    <div
                        class="oe_button_box"
                        name="button_box"
                    >

                        <button
                            name="action_view_offers"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-money"
                        >

                            <field
                                name="offer_count"
                                widget="statinfo"
                                string="Offers"
                            />

                        </button>

                    </div>


                    <!-- ========================= -->
                    <!-- Main Fields -->
                    <!-- ========================= -->

                    <group>

                        <group>

                            <field name="name"/>

                            <field name="owner_id"/>

                            <field
                                name="owner_email"
                                readonly="1"
                            />

                            <field
                                name="owner_phone"
                                readonly="1"
                            />

                            <field
                                name="buyer_id"
                                readonly="1"
                            />

                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                            />

                            <field name="bedrooms"/>

                            <field name="living_area"/>

                        </group>


                        <group>

                            <field name="expected_price"/>

                            <field name="selling_price"/>

                            <field
                                name="difference"
                                readonly="1"
                            />

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- Offers -->
                    <!-- ========================= -->

                    <notebook>

                        <page string="Offers">

                            <field name="offer_ids">

                                <list editable="bottom">

                                    <field name="partner_id"/>

                                    <field name="price"/>

                                    <field name="status"/>

                                    <button
                                        name="action_accept"
                                        type="object"
                                        string="Accept"
                                        icon="fa-check"
                                    />

                                    <button
                                        name="action_refuse"
                                        type="object"
                                        string="Refuse"
                                        icon="fa-times"
                                    />

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ========================= -->
    <!-- Search View -->
    <!-- ========================= -->

    <record id="estate_property_search_view" model="ir.ui.view">

        <field name="name">estate.property.search</field>

        <field name="model">estate.property</field>

        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="owner_id"/>

                <field name="owner_email"/>

                <field name="owner_phone"/>

                <field name="buyer_id"/>


                <filter
                    name="filter_new"
                    string="New"
                    domain="[('state', '=', 'new')]"
                />


                <filter
                    name="filter_sold"
                    string="Sold"
                    domain="[('state', '=', 'sold')]"
                />


                <filter
                    name="filter_cancelled"
                    string="Cancelled"
                    domain="[('state', '=', 'cancelled')]"
                />

            </search>

        </field>

    </record>


    <!-- ========================= -->
    <!-- Menus -->
    <!-- ========================= -->

    <menuitem
        id="estate_menu_root"
        name="Real Estate"
    />


    <menuitem
        id="estate_first_level_menu"
        name="Advertisements"
        parent="estate_menu_root"
    />


    <menuitem
        id="estate_property_menu_action"
        name="Properties"
        parent="estate_first_level_menu"
        action="estate_property_action"
    />

</odoo>